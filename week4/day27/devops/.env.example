# Public browser port
APP_PORT=8080

# Generate a unique, strong secret before starting Docker Compose.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Backend authentication token lifetime
JWT_EXPIRES_IN=7d

# Allowed browser origins, comma-separated
FRONTEND_URL=http://localhost:8080,http://127.0.0.1:8080

# Existing Day 26 AI gateway running on the Windows host
AI_GATEWAY_URL=http://host.docker.internal:5003