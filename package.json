{
  "name": "sda-training",
  "version": "1.0.0",
  "description": "Mechlin SDA Advanced Training Program - Full-stack development with AI, DevOps, and mobile expertise",
  "main": "index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "python -m pytest week4/day23/tests -v",
    "lint": "biome lint week4/day23/ai/web-ai-integration.js",
    "lint:fix": "biome lint --write week4/day23/ai/web-ai-integration.js",
    "format": "prettier --write .",
    "setup": "node scripts/setup.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "k8s:deploy": "kubectl apply -f k8s/",
    "k8s:delete": "kubectl delete -f k8s/"
  },
  "keywords": [
    "training",
    "fullstack",
    "react",
    "nodejs",
    "mobile",
    "devops",
    "ai",
    "machine-learning"
  ],
  "author": "Mechlin Technology",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "openai": "^7.17.0",
    "pg": "^8.11.3",
    "redis": "^4.6.8",
    "socket.io": "^4.7.2",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "prettier": "^3.0.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mechlin-tech/sda-training.git"
  },
  "bugs": {
    "url": "https://github.com/mechlin-tech/sda-training/issues"
  },
  "homepage": "https://github.com/mechlin-tech/sda-training#readme"
}
